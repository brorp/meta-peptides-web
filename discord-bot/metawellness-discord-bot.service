[Unit]
Description=Meta Wellness Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/meta-peptides-web/discord-bot
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=PM2_HOME=/home/ubuntu/.pm2
ExecStart=/usr/bin/pm2-runtime start /home/ubuntu/meta-peptides-web/discord-bot/ecosystem.config.cjs --only metawellness-discord-bot
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
