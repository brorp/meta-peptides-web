# Copy this file to whatsapp-listener/.env (ignored by git) and fill it in.

# Website that serves /api/bot/* (no trailing slash, no /api)
METAWELLNESS_API_BASE_URL=https://meta-peptides.com

# Shared secret: must be EXACTLY the same value as WHATSAPP_LISTENER_SECRET on
# Vercel. Different from DISCORD_BOT_API_SECRET. Generate with: openssl rand -hex 32
WHATSAPP_LISTENER_SECRET=paste-the-same-secret-as-vercel

# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook > Copy URL.
# New WhatsApp lead cards and the 12.00 / 23.00 analysis digest are posted here.
DISCORD_WA_WEBHOOK_URL=https://discord.com/api/webhooks/123/abc

# Optional: webhook of the whatsapp-settings channel. Connection warnings
# (logged out, disconnected, not logged in) go here; without it they go to the
# leads channel above.
DISCORD_WA_SETTINGS_WEBHOOK_URL=https://discord.com/api/webhooks/456/def

# Recommended: the CS WhatsApp number. If someone links another number (by
# scanning the QR from !walogin), the listener unlinks it right away and never
# reads its chats.
WA_EXPECTED_PHONE=6281234567890

# Optional: first-message texts from your ads (prefilled message), separated by |.
# A chat starting with one of these counts as origin "ads" even when WhatsApp
# does not send the ad info.
WA_AD_TEXT_PATTERNS=Halo, saya mau tanya|Hi, I'm interested

# Optional: 0 turns off saving leads as contacts in the WhatsApp account
# (default on: new leads and changed names, every 2 minutes, ~3 s apart).
WA_SAVE_CONTACTS=1

# Optional: error (default), warn, info. Never use debug/trace in production:
# Baileys logs message content at those levels.
WA_LOG_LEVEL=error

# Optional: where the control socket for the Discord bot is created
# (default: control.sock in this folder).
# WA_CONTROL_SOCKET=/home/ubuntu/meta-peptides-web/whatsapp-listener/control.sock
