RESEND_API_KEY=
RESEND_FROM_EMAIL=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
# Comma-separated trusted aliases used for auth and password-reset redirects.
APP_ALLOWED_ORIGINS=https://meta-peptides.com,https://metawellness.id

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin Dashboard
ADMIN_ACCESS_CODE=your-secure-access-code-here
ADMIN_STAFF_ACCESS_CODE=your-staff-admin-access-code-here
ADMIN_JWT_SECRET=your-random-jwt-secret-here

# Discord Bot API for /api/bot/* (server-side only; never prefix with NEXT_PUBLIC_).
# Set the same four values in discord-bot/.env. See discord-bot/README.md.
# Shared secret, generate with: openssl rand -hex 32
DISCORD_BOT_API_SECRET=replace-with-openssl-rand-hex-32
# Discord server (guild) ID
DISCORD_GUILD_ID=discord-server-id
# Channels allowed to use the bot, comma separated
DISCORD_ALLOWED_CHANNEL_IDS=channel-id-1,channel-id-2
# Private directors channel(s) for !addexpense, !reimbursement, !updateproduct
DISCORD_DIRECTORS_CHANNEL_IDS=directors-channel-id
