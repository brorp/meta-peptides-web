[Unit]
Description=Meta Wellness WhatsApp listener (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/meta-peptides-web/whatsapp-listener
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
# Its own pm2 home: the Discord bot's pm2-runtime already uses ~/.pm2, and two
# pm2-runtime processes on one home would fight over the same daemon sockets.
Environment=PM2_HOME=/home/ubuntu/.pm2-wa-listener
ExecStart=/usr/bin/pm2-runtime start /home/ubuntu/meta-peptides-web/whatsapp-listener/ecosystem.config.cjs --only metawellness-wa-listener
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
