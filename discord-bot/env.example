# Copy this file to discord-bot/.env (already ignored by git) and fill it in.
# Never commit the real values or put them in NEXT_PUBLIC_* variables.

# Discord Developer Portal > your application > Bot > Reset Token
DISCORD_BOT_TOKEN=paste-bot-token-here

# Right-click the Discord server > Copy Server ID (needs Developer Mode)
DISCORD_GUILD_ID=123456789012345678

# Channels where the bot answers, comma separated (right-click channel > Copy Channel ID)
DISCORD_ALLOWED_CHANNEL_IDS=111111111111111111,222222222222222222

# Private directors channel(s) for !addexpense and !reimbursement
DISCORD_DIRECTORS_CHANNEL_IDS=333333333333333333

# Shared secret: must be EXACTLY the same value as DISCORD_BOT_API_SECRET on Vercel.
# Generate with: openssl rand -hex 32
DISCORD_BOT_API_SECRET=paste-the-same-secret-as-vercel

# Website that serves /api/bot/* (no trailing slash, no /api)
METAWELLNESS_API_BASE_URL=https://meta-peptides.com

# Optional: shown on the invoice text sent to customers
INVOICE_BRAND_NAME=MetaPeptides
# Optional: payment instructions appended to unpaid invoice text. Use \n for new lines.
INVOICE_PAYMENT_INFO=Transfer ke BCA 1234567890 a.n. PT Contoh\nKirim bukti transfer ke chat ini ya kak
